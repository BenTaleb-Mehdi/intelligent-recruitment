# Application Server Port
PORT=5000

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=your_auth_secret_key_here

# Relational Database Connection (MySQL / MariaDB via Prisma)
DATABASE_URL="mysql://username:password@localhost:3306/recrutement_db"

# NoSQL Database Connection (MongoDB Atlas / Local for GridFS CV Storage)
MONGO_URI="mongodb://username:password@cluster.mongodb.net:27017/recruitment_db?ssl=true&authSource=admin"

# External n8n Webhook Integration
N8N_CV_WEBHOOK_URL="https://n8n.iksatech.com/webhook/cv-uploaded"
N8N_WEBHOOK_URL="https://n8n.iksatech.com/webhook/generate-description"
WEBHOOK_SECRET=your_n8n_secret_token_here

# Social OAuth Credentials (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# SMTP Email Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
