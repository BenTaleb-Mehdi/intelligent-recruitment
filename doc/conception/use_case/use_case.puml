@startuml
' --- Configuration du Design ---
left to right direction
skinparam shadowing false
skinparam monochrome true
skinparam packageStyle rectangle

' --- Les Acteurs ---
actor "Candidat" as Candidate
actor "Recruteur" as Recruiter
actor "Administrateur" as Admin

' --- Le Système ---
rectangle "Plateforme de Recrutement IA" {
    
    '--- Bloc Authentification & Profil ---
    rectangle "Authentification & Profil" {
        usecase "S'authentifier (Social / Manuel)" as UC_Auth
        usecase "Compléter l'Onboarding (Choix du Rôle)" as UC_Onboard
    }
    
    '--- Espace Candidat ---
    rectangle "Espace Candidat" {
        usecase "Gérer le Profil (CV & Synchro GitHub/Portfolio)" as UC_UploadData
        usecase "Consulter les Offres Recommandées (Score %)" as UC_ViewJobs
        usecase "Postuler à une Offre d'Emploi" as UC_Apply
        usecase "Passer le Quiz Technique Automatique" as UC_TakeQuiz
        usecase "Suivre le Statut des Candidatures" as UC_TrackApps
    }
    
    '--- Espace Recruteur ---
    rectangle "Espace Recruteur" {
        usecase "Créer une Offre d'Emploi" as UC_CreateJob
        usecase "Générer Automatiquement un Quiz (IA)" as UC_GenQuiz
        usecase "Consulter & Valider le Quiz Technique" as UC_ValidateQuiz
        usecase "Consulter le Ranking des Candidats & Explications IA" as UC_RankApplicants
        usecase "Visualiser le Dashboard Analytics" as UC_RecruiterDash
        usecase "Gérer le Profil Entreprise & Configurations IA" as UC_RecruiterSettings
    }
    
    '--- Espace Admin ---
    rectangle "Espace Administration" {
        usecase "Modérer les Utilisateurs" as UC_ManageUsers
        usecase "Modérer les Offres d'Emploi" as UC_ModerateJobs
        usecase "Surveiller les Quizzes Générés (Monitoring)" as UC_MonitorQuizzes
        usecase "Suivre les Statistiques Globales" as UC_AdminDash
    }
}

' --- Les Liaisons (Relations) ---

' Relations Candidat
Candidate --> UC_Auth
Candidate --> UC_Onboard
Candidate --> UC_UploadData
Candidate --> UC_ViewJobs
Candidate --> UC_Apply
Candidate --> UC_TakeQuiz
Candidate --> UC_TrackApps

' Relations Recruteur
Recruiter --> UC_Auth
Recruiter --> UC_Onboard
Recruiter --> UC_CreateJob
Recruiter --> UC_ValidateQuiz
Recruiter --> UC_RankApplicants
Recruiter --> UC_RecruiterDash
Recruiter --> UC_RecruiterSettings

' Relations Admin
Admin --> UC_Auth
Admin --> UC_ManageUsers
Admin --> UC_ModerateJobs
Admin --> UC_MonitorQuizzes
Admin --> UC_AdminDash

' Relation Spécifique entre Use Cases
UC_CreateJob ..> UC_GenQuiz : <<include>>
UC_GenQuiz ..> UC_ValidateQuiz : <<extend>>

@enduml